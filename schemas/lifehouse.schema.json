{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifehouse:dataset:schema:0.1.0",
  "title": "Lifehouse Psychosocial Dataset (prototype 0.1)",
  "type": "object",
  "required": [
    "format",
    "version",
    "project",
    "psychometry",
    "sociometry",
    "playback"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lifehouse-psychosocial"
    },
    "version": {
      "const": "0.1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "data_class"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "data_class": {
          "enum": [
            "synthetic",
            "pseudonymized"
          ]
        }
      }
    },
    "psychometry": {
      "type": "object",
      "required": [
        "model",
        "instrument",
        "scoring",
        "dimensions",
        "participants"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "interpersonal-circumplex"
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "scoring": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "id",
                "label",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "const": "agency"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "id",
                "label",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "const": "communion"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          ],
          "items": false
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "scores"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "scores": {
                "type": "object",
                "required": [
                  "agency",
                  "communion"
                ],
                "additionalProperties": false,
                "properties": {
                  "agency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "communion": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "sociometry": {
      "type": "object",
      "required": [
        "criterion",
        "type",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "directed_positive_weighted"
        },
        "links": {
          "type": "array",
          "maxItems": 144,
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "required": [
        "tempo_bpm",
        "bars",
        "meter",
        "scale",
        "mapping_id"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo_bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 240
        },
        "bars": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "meter": {
          "const": [
            4,
            4
          ]
        },
        "scale": {
          "const": "d_dorian"
        },
        "mapping_id": {
          "const": "circumplex-demo-v0.1"
        }
      }
    }
  }
}
