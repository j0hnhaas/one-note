{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j0hnhaas.github.io/one-note/schemas/lifehouse-session.schema.json",
  "title": "ONE NOTE session 0.2 — psychometry, biometrics, optional sociometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "project",
    "participants",
    "composition"
  ],
  "properties": {
    "format": {
      "const": "lifehouse-session"
    },
    "version": {
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "data_class"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "data_class": {
          "enum": [
            "synthetic",
            "pseudonymized",
            "sensitive_local"
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "psychometrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "big_five": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instrument",
                  "instrument_version",
                  "scoring",
                  "scores"
                ],
                "properties": {
                  "instrument": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instrument_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scoring": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scores": {
                    "type": "object",
                    "required": [
                      "openness",
                      "conscientiousness",
                      "extraversion",
                      "agreeableness",
                      "neuroticism"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "openness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "conscientiousness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "extraversion": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "agreeableness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "neuroticism": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              },
              "extended": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instrument",
                  "instrument_version",
                  "scoring",
                  "scores"
                ],
                "properties": {
                  "instrument": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instrument_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scoring": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scores": {
                    "type": "object",
                    "required": [
                      "warmth",
                      "analytical_interest",
                      "emotional_stability",
                      "assertiveness",
                      "liveliness",
                      "rule_orientation",
                      "social_boldness",
                      "sensitivity",
                      "vigilance",
                      "imagination",
                      "privacy",
                      "self_doubt",
                      "flexibility",
                      "self_reliance",
                      "orderliness",
                      "tension"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "warmth": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "analytical_interest": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "emotional_stability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "assertiveness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "liveliness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "rule_orientation": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "social_boldness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sensitivity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "vigilance": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "imagination": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "privacy": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "self_doubt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "flexibility": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "self_reliance": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "orderliness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "tension": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "biometrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "heart_rate": {
                "type": "object",
                "required": [
                  "unit",
                  "samples"
                ],
                "additionalProperties": false,
                "properties": {
                  "unit": {
                    "const": "bpm"
                  },
                  "baseline_bpm": {
                    "type": "number",
                    "minimum": 35,
                    "maximum": 220
                  },
                  "samples": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "t_seconds",
                        "bpm",
                        "quality"
                      ],
                      "properties": {
                        "t_seconds": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 3600
                        },
                        "bpm": {
                          "type": "number",
                          "minimum": 35,
                          "maximum": 220
                        },
                        "quality": {
                          "enum": [
                            "measured",
                            "manual",
                            "simulated"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sociometry": {
      "type": "object",
      "required": [
        "criterion",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "tempo_bpm",
        "bars",
        "seed",
        "mapping_id"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo_bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 240
        },
        "bars": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "seed": {
          "type": "integer"
        },
        "mapping_id": {
          "const": "one-note-dual-layer-demo-v0.2"
        }
      }
    }
  }
}
